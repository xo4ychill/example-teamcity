<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  
  <!-- 🔑 ИСКЛЮЧЕНИЕ: не использовать Nexus для JetBrains DSL -->
  <mirrors>
    <mirror>
      <id>nexus-mirror</id>
      <mirrorOf>*,!jetbrains-public</mirrorOf>  <!-- Исключаем jetbrains-public -->
      <url>http://%env.NEXUS_URL%:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>
  
  <servers>
    <server>
      <id>nexus</id>
      <username>%env.NEXUS_USER%</username>
      <password>%env.NEXUS_PASSWORD%</password>
    </server>
  </servers>
  
  <profiles>
    <profile>
      <id>nexus</id>
      <repositories>
        <!-- JetBrains DSL (прямой доступ) -->
        <repository>
          <id>jetbrains-public</id>
          <url>https://download.jetbrains.com/teamcity-repository</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <!-- Nexus для остальных зависимостей -->
        <repository>
          <id>nexus-public</id>
          <url>http://%env.NEXUS_URL%:8081/repository/maven-public/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>
  
  <activeProfiles>
    <activeProfile>nexus</activeProfile>
  </activeProfiles>
</settings>